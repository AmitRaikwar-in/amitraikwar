    "@tsparticles/react": "^3.0.0",
    "@tsparticles/slim": "^3.7.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.18.91",
    "@types/react": "^18.2.69",
    "@types/react-dom": "^18.2.22",
    "axios": "^1.7.9",
    "framer-motion": "^11.1.9",
    "fuse.js": "^7.0.0",
    "gsap": "^3.12.7",
